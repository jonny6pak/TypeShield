#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATE="$ROOT_DIR/Resources/com.typeshield.agent.plist"
DEST="$HOME/Library/LaunchAgents/com.typeshield.agent.plist"

if [ ! -f "$TEMPLATE" ]; then
  echo "Missing template: $TEMPLATE" >&2
  exit 1
fi

mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"

sed "s#__HOME__#$HOME#g" "$TEMPLATE" > "$DEST"
chmod 644 "$DEST"

UID_NUM="$(id -u)"
launchctl bootout "gui/$UID_NUM" "$DEST" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$UID_NUM" "$DEST"
launchctl enable "gui/$UID_NUM/com.typeshield.agent"
launchctl kickstart -k "gui/$UID_NUM/com.typeshield.agent"

echo "Installed and started TypeShield LaunchAgent:"
echo "  $DEST"
echo ""
echo "Verify with:"
echo "  launchctl print gui/$(id -u)/com.typeshield.agent | head -n 40"
